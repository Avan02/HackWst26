{
  "name": "hackwst26",
  "private": true,
  "version": "0.1.0",
  "description": "TutorMatch - matches students to tutors by learning style, records sessions, and turns them into AI notes with timestamps.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@tutormatch/api",
    "build": "npm run build --workspaces --if-present",
    "db:schema": "npm run db:schema --workspace=@tutormatch/api",
    "db:seed": "npm run db:seed --workspace=@tutormatch/api"
  },
  "engines": {
    "node": ">=20"
  }
}
