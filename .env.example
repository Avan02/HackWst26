# Copy to .env and fill in. NEVER commit the real .env.

# --- API ---
PORT=3000
HOST=0.0.0.0

# --- TigerData (Postgres + TimescaleDB + pgvector) ---
# Phase 2. Needs sslmode=require.
TIGER_URL=postgres://user:pass@host:port/dbname?sslmode=require

# --- Vultr Object Storage (S3-compatible) ---
# Phase 2. Sam needs these for recording uploads.
VULTR_OBJ_ENDPOINT=ewr1.vultrobjects.com
VULTR_OBJ_BUCKET=tutormatch
VULTR_OBJ_KEY=
VULTR_OBJ_SECRET=

# --- Auth0 ---
# Phase 3. Agree the audience + claim namespace with Brayden.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.tutormatch.tech
AUTH0_CLAIM_NAMESPACE=https://tutormatch.tech

# --- Gemini ---
# Phase 4 (embeddings for matching). Evan has his own key for transcripts.
GEMINI_API_KEY=

# --- Solana ---
# Phase 5. Devnet only.
SOLANA_RPC_URL=https://api.devnet.solana.com
PLATFORM_WALLET=
