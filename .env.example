# Copy to .env and fill in. .env is gitignored - safe for secrets.

# TigerData connection string. Looks like:
#   postgres://tsdbadmin:PASSWORD@host.tsdb.cloud.timescale.com:12345/tsdb?sslmode=require
TIGER_URL=

# Gemini API key, for the transcription pipeline.
GEMINI_API_KEY=

# Auth0 application settings (from the Auth0 dashboard for this app).
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# 64-character random string used to encrypt the session cookie.
# Generate with: openssl rand -hex 32
AUTH0_SECRET=

# Where the app is served locally, and what port to run it on.
APP_BASE_URL=
PORT=

# Cloudflare TURN, so video calls connect on restrictive networks.
# Cloudflare dashboard -> Realtime -> TURN Server. Optional: without these,
# calls fall back to direct connections only.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
