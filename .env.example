# Copy to .env and fill in. .env is gitignored - safe for secrets.

# TigerData connection string. Looks like:
#   postgres://tsdbadmin:PASSWORD@host.tsdb.cloud.timescale.com:12345/tsdb?sslmode=require
TIGER_URL=

# Gemini API key, for embedding learner profiles and tutor bios.
# Optional: without it, a local fallback embedding is used so the pipeline
# still runs end to end - just less accurate.
GEMINI_API_KEY=
